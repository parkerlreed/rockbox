<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	package="org.rockbox.sim"
	android:versionCode="1"
	android:versionName="1.0">

	<uses-feature android:glEsVersion="0x00020000" />
	<uses-feature android:name="android.hardware.touchscreen" android:required="false" />

	<!-- The simdisk is /sdcard/Rockbox -->
	<uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
	<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
		android:maxSdkVersion="29" />

	<!-- Clickwheel vibration -->
	<uses-permission android:name="android.permission.VIBRATE" />

	<!-- The camera plugin -->
	<uses-permission android:name="android.permission.CAMERA" />
	<uses-feature android:name="android.hardware.camera" android:required="false" />

	<!-- Keep playing in the background -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

	<!-- Codecs and plugins are dlopen()ed by path, see load_code-sim.c -->
	<application android:label="Rockbox"
		android:icon="@drawable/launcher"
		android:extractNativeLibs="true"
		android:hardwareAccelerated="true"
		android:requestLegacyExternalStorage="true"
		android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

		<!-- in a process of its own, to restart the simulator when
		     switching models, see RockboxSimActivity.switchModel() -->
		<activity android:name=".RockboxSimLauncher"
			android:process=":launcher"
			android:exported="true"
			android:theme="@android:style/Theme.Translucent.NoTitleBar">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity>

		<activity android:name=".RockboxSimActivity"
			android:exported="false"
			android:launchMode="singleTask"
			android:screenOrientation="fullUser"
			android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation" />

		<service android:name=".RockboxSimService"
			android:exported="false"
			android:foregroundServiceType="mediaPlayback" />
	</application>
</manifest>
